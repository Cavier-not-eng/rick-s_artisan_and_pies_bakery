            emoji: "🥕"
        }

    ];

    const randomNumber =
        Math.floor(
            Math.random() * pies.length
        );

    const pie =
        pies[randomNumber];

    document.getElementById(
        "random-pie-result"
    ).innerHTML = `

        <div>
            ${pie.emoji}
        </div>

        <h3>
            ${pie.name}
        </h3>

        <p>
            ${pie.description}
        </p>

        <strong>
            ${pie.price}
        </strong>

    `;
}


/* =========================
   FAVOURITES
========================= */

function favouritePie(button) {

    if (
        button.textContent.includes("Favourite")
    ) {

        button.textContent =
            "❤️ Favourited";

    } else {

        button.textContent =
            "🤍 Favourite";
    }

}


/* =========================
   DARK MODE
========================= */

function toggleDarkMode() {

    document.body.classList.toggle(
        "dark-mode"
    );

}


/* =========================
   PIE CHALLENGE
========================= */

function pieChallenge() {

    const ingredients = [

        "Beef 🥩",
        "Chicken 🍗",
        "Apple 🍎",
        "Bacon 🥓",
        "Mushrooms 🍄",
        "Cheese 🧀",
        "Vegetables 🥕"

    ];

    const random =
        ingredients[
            Math.floor(
                Math.random() *
                ingredients.length
            )
        ];

    document.getElementById(
        "challenge-result"
    ).textContent =
        "🤫 Today's mystery ingredient is: "
        + random;

}


