<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact Directory</title>

<style>
:root {
    --background: #f4f6f9;
    --card: #ffffff;
    --sidebar: #172033;
    --accent: #38bdf8;
    --text: #243047;
    --muted: #64748b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 25px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
}

/* SIDEBAR */

.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 72px;
    background: var(--sidebar);
    color: white;
    overflow-x: hidden;
    overflow-y: auto;
    transition: width 0.3s ease;
    z-index: 1000;
    white-space: nowrap;
    box-shadow: 3px 0 15px #00000015;
}

.sidebar:hover,
.sidebar:focus-within,
.sidebar.open {
    width: 250px;
}

.sidebar-header {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 23px;
    font-size: 1.2rem;
    font-weight: bold;
    border-bottom: 1px solid #ffffff20;
}

.sidebar-header .icon {
    font-size: 1.7rem;
    min-width: 26px;
}

.sidebar ul {
    list-style: none;
    padding: 15px 10px;
}

.sidebar li {
    margin: 8px 0;
}

.sidebar a,
.menu-toggle {
    display: flex;
    align-items: center;
    gap: 17px;
    padding: 13px 12px;
    border-radius: 9px;
    color: white;
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.2s, color 0.2s;
}

.sidebar a:hover,
.sidebar a:focus-visible {
    background: var(--accent);
    color: #102033;
}

.sidebar a .icon,
.menu-toggle .icon {
    min-width: 26px;
    text-align: center;
    font-size: 1.3rem;
}

.menu-toggle {
    width: calc(100% - 20px);
    margin: 12px 10px 0;
    background: transparent;
    border: none;
    cursor: pointer;
    font: inherit;
    color: white;
}

.menu-toggle:hover {
    background: #ffffff15;
}

/* MAIN CONTENT */

main {
    margin-left: 72px;
    padding: 35px;
    transition: margin-left 0.3s ease;
}

body:has(.sidebar:hover) main,
body:has(.sidebar:focus-within) main,
body:has(.sidebar.open) main {
    margin-left: 250px;
}

header {
    background: linear-gradient(135deg, #172033, #334765);
    color: white;
    padding: 35px;
    border-radius: 18px;
    margin-bottom: 30px;
}

header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 10px;
}

header p {
    color: #d7e2f0;
    line-height: 1.6;
}

.search-area {
    margin: 25px 0;
}

.search-area label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
}

#searchInput {
    width: 100%;
    max-width: 550px;
    padding: 14px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 1rem;
    background: white;
    color: #172033;
}

#searchInput:focus {
    outline: 3px solid #38bdf850;
    border-color: #0284c7;
}

/* CONTACT SECTIONS */

.contact-section {
    margin: 40px 0;
    scroll-margin-top: 25px;
}

.section-heading {
    margin-bottom: 20px;
}

.section-heading h2 {
    font-size: 1.7rem;
    margin-bottom: 6px;
}

.section-heading p {
    color: var(--muted);
}

.contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.contact {
    background: var(--card);
    padding: 23px;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 5px 15px #00000008;
    transition: transform 0.2s, box-shadow 0.2s;
    overflow-wrap: anywhere;
}

.contact:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px #00000012;
}

.contact h3 {
    font-size: 1.15rem;
    margin-bottom: 14px;
    color: #172033;
}

.contact p {
    margin: 9px 0;
    color: #475569;
    font-size: 0.92rem;
}

.contact a {
    color: #0369a1;
    text-decoration: none;
}

.contact a:hover {
    text-decoration: underline;
}

.contact-icon {
    display: inline-block;
    width: 24px;
}

.no-results {
    display: none;
    padding: 25px;
    background: white;
    border-radius: 10px;
    text-align: center;
    color: var(--muted);
}

.back-top {
    display: inline-block;
    margin-top: 20px;
    color: #0369a1;
    text-decoration: none;
    font-weight: bold;
}

footer {
    margin-top: 45px;
    padding: 25px;
    text-align: center;
    color: var(--muted);
    border-top: 1px solid #dbe3ed;
}

/* RESPONSIVE LAYOUT */

@media (max-width: 1000px) {
    .contact-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    main {
        padding: 18px;
    }

    header {
        padding: 25px 20px;
    }

    .contact-grid {
        grid-template-columns: 1fr;
    }

    .sidebar:hover,
    .sidebar:focus-within,
    .sidebar.open {
        width: 235px;
    }

    body:has(.sidebar:hover) main,
    body:has(.sidebar:focus-within) main,
    body:has(.sidebar.open) main {
        margin-left: 72px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition: none !important;
    }
}
