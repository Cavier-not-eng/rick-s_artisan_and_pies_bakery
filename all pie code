<script>
// Expand and collapse the sidebar with the menu button.
// Hovering over the sidebar also expands it.
const sidebar = document.getElementById("sidebar");
const menuToggle = document.getElementById("menuToggle");

menuToggle.addEventListener("click", function () {
    sidebar.classList.toggle("open");

    const isOpen = sidebar.classList.contains("open");
    menuToggle.setAttribute("aria-expanded", isOpen);
});

// Close the pinned sidebar after selecting a link.
document.querySelectorAll(".sidebar a").forEach(function (link) {
    link.addEventListener("click", function () {
        sidebar.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
    });
});

// Search names, email addresses and phone numbers.
function searchContacts() {
    const searchValue = document
        .getElementById("searchInput")
        .value.toLowerCase()
        .trim();

    const contacts = document.querySelectorAll(".contact");
    const sections = document.querySelectorAll(".contact-section");

    let visibleCount = 0;

    contacts.forEach(function (contact) {
        const contactText = contact.textContent.toLowerCase();
        const matches = contactText.includes(searchValue);

        contact.style.display = matches ? "" : "none";

        if (matches) {
            visibleCount++;
        }
    });

    // Hide group headings when none of their contacts match.
    sections.forEach(function (section) {
        const visibleContacts = section.querySelectorAll(
            '.contact:not([style*="display: none"])'
        );

        section.style.display =
            visibleContacts.length > 0 ? "" : "none";
    });

    document.getElementById("noResults").style.display =
        visibleCount === 0 ? "block" : "none";
}
</script>

